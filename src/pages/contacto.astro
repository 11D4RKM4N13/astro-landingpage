---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";

const canales = [
	{
		titulo: "WhatsApp",
		descripcion: "Respuesta en menos de 24 horas",
		enlace: `https://wa.me/${SITE.whatsAppAccount}?text=${encodeURIComponent(SITE.whatsAppMessage)}`,
		etiqueta: "Escribir ahora",
		color: "border-green text-green",
		btnColor: "bg-green hover:bg-green-hover text-white",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.857L.057 23.882l6.174-1.453A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.371l-.36-.214-3.724.876.936-3.614-.235-.372A9.818 9.818 0 1112 21.818z"/></svg>`,
	},
	{
		titulo: "Instagram",
		descripcion: "Síguenos y escríbenos por DM",
		enlace: SITE.instagramHandle,
		etiqueta: "Ver perfil",
		color: "border-pink text-pink",
		btnColor: "bg-pink hover:bg-pink-hover text-white",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
	},
	{
		titulo: "Facebook",
		descripcion: "Encuéntranos y escríbenos",
		enlace: SITE.facebookHandle,
		etiqueta: "Ver página",
		color: "border-blue-light text-blue-light",
		btnColor: "bg-blue-light hover:bg-blue-light-hover text-white",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
	},
];
---

<Layout
	title={`Contacto | ${SITE.title}`}
	description="Contáctanos para cotizar lanyards y cintas personalizadas. Respondemos en menos de 24 horas. Escríbenos por WhatsApp o llena el formulario."
	canonicalURL={`${SITE.url}/contacto`}
>
	<Header />
	<main id="main-content" role="main">
		<!-- Hero -->
		<section class="bg-primary py-20 px-4 text-center">
			<ScrollReveal client:load>
				<span
					class="font-heading text-accent text-sm uppercase tracking-widest font-medium"
				>
					Hablemos
				</span>
				<h1 class="font-heading text-4xl md:text-5xl font-bold text-white mt-2">
					Contáctanos
				</h1>
				<p class="font-body text-white/80 mt-4 max-w-xl mx-auto">
					¿Tienes un evento, una empresa o una idea? Escríbenos y te ayudamos a
					hacerla realidad con el producto perfecto.
				</p>
			</ScrollReveal>
		</section>

		<!-- Canales de contacto -->
		<section class="max-w-6xl mx-auto px-4 py-16">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{
					canales.map((canal, i) => (
						<ScrollReveal client:load delay={i * 0.15}>
							<div
								class:list={[
									"flex flex-col items-center text-center gap-4 p-8 rounded-2xl border-2 h-full",
									canal.color,
								]}
							>
								<span>
									<Fragment set:html={canal.icon} />
								</span>
								<h3 class="font-heading text-xl font-semibold text-primary">
									{canal.titulo}
								</h3>
								<p class="font-body text-sm text-gray-dark/70 flex-1">
									{canal.descripcion}
								</p>

								<a
									href={canal.enlace}
									target="_blank"
									rel="noopener noreferrer"
									class:list={[
										"font-heading font-medium text-sm px-6 py-3 rounded-lg transition-colors duration-200",
										canal.btnColor,
									]}
								>
									{canal.etiqueta}
								</a>
							</div>
						</ScrollReveal>
					))
				}
			</div>
		</section>

		<!-- Formulario -->
		<section class="max-w-2xl mx-auto px-4 pb-20">
			<ScrollReveal client:load>
				<div class="text-center mb-10">
					<h2 class="font-heading text-heading-xl font-semibold text-primary">
						Envíanos un mensaje
					</h2>
					<p class="font-body text-gray-dark/70 mt-2">
						Completa el formulario y te contactamos a la brevedad.
					</p>
				</div>
			</ScrollReveal>

			<ScrollReveal client:load delay={0.2}>
				<div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm">
					<ContactForm />
				</div>
			</ScrollReveal>
		</section>
	</main>
	<Footer />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`About | ${SITE.title}`}
  description="Learn more about Astro Base - a minimal, modern starter template for building fast websites with Astro, React, Tailwind CSS, and Framer Motion."
  canonicalURL={`${SITE.url}/about`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-4xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold text-gray-900 mb-4">G&CO Creativos</h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.1}>
        <p class="text-xl text-gray-600 mb-12">
          Somos una agencia de diseño y marketing digital especializada en soluciones creativas para empresas. Nuestro equipo de expertos trabaja estrechamente con cada cliente para entender sus necesidades y objetivos, ofreciendo servicios personalizados que incluyen diseño gráfico, desarrollo web, gestión de redes sociales, publicidad digital y estrategias de branding. En G&CO Creativos, nos apasiona ayudar a las marcas a destacar en el mercado competitivo actual, creando experiencias únicas que conectan con su audiencia y generan resultados tangibles.
        </p>
      </ScrollReveal>

      <div class="prose prose-lg max-w-none">
        <ScrollReveal client:load delay={0.2}>
          <h2>Productos y servicios</h2>
          <ul>
            <li>
              <strong>Astro</strong> - Lightning-fast static site generation
            </li>
            <li>
              <strong>React</strong> - Component-based UI library for interactive
              components
            </li>
            <li>
              <strong>Tailwind CSS v4</strong> - Utility-first CSS framework for rapid
              styling
            </li>
            <li>
              <strong>Framer Motion</strong> - Smooth scroll reveal animations with
              spring physics
            </li>
            <li>
              <strong>Astro Icons</strong> - Beautiful icon component library with
              Tabler icon set
            </li>
            <li><strong>MDX</strong> - Write JSX in your Markdown documents</li>
            <li>
              <strong>Sass</strong> - CSS preprocessor with variables, mixins, and
              nesting
            </li>
            <li>
              <strong>Tailwind Typography</strong> - Beautiful typography styles for
              markdown content
            </li>
          </ul>
        </ScrollReveal>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";

import SocialProof from "../components/SocialProof.astro";

import WhatsappButton from "../components/WhatsappButton.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.mjs";

import { getCollection } from "astro:content";
import ProductCard from "../components/ProductCard.astro";

import Steps from "../components/Steps.astro";

const destacados = (await getCollection("productos"))
	.filter((p: any) => p.data.destacado)
	.slice(0, 3);
---

<Layout
	title={SITE.title}
	description={SITE.description}
	canonicalURL={SITE.url}
>
	<!-- Encabezado -->
	<Header />

	<main id="main-content" role="main">
		<!-- Sección de héroe -->
		<Hero />

		<!-- Sección de prueba de social -->
		<SocialProof />

		<!-- -->
		<section class="max-w-6xl mx-auto px-4 py-20">
			<h2
				class="font-heading text-heading-xl font-semibold text-primary text-center mb-4"
			>
				Nuestros productos
			</h2>
			<p class="font-body text-center text-gray-dark/70 mb-12 max-w-xl mx-auto">
				Fabricamos lanyards y cintas personalizadas para todo tipo de eventos y
				empresas.
			</p>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{
					destacados.map((p: any) => (
						<ProductCard
							nombre={p.data.nombre}
							descripcion={p.data.descripcion}
							precio={p.data.precio}
							categoria={p.data.categoria}
							imagen={p.data.imagen}
							slug={p.slug}
						/>
					))
				}
			</div>

			<div class="text-center mt-12">
				<a
					href="/productos"
					class="border border-primary text-primary hover:bg-primary hover:text-white font-heading font-medium px-8 py-3 rounded-lg transition-colors duration-200"
				>
					Ver catálogo completo
				</a>
			</div>
		</section>
	</main>

	<!-- Sección de pasos -->
	<Steps />
</Layout>

<!-- Botón de WhatsApp -->
<WhatsappButton />

<!-- Pie de página -->
<Footer />

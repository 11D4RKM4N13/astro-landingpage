---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { Image } from "astro:assets";
import { SITE } from "../config/site.mjs";
import videoProceso from "../assets/20260508_140226.mp4";

const valores = [
	{
		titulo: "Calidad garantizada",
		descripcion:
			"Usamos materiales de primera selección en cada producto que fabricamos.",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
		color: "border-accent bg-accent/5 text-accent",
		iconColor: "text-accent",
	},
	{
		titulo: "Diseño a medida",
		descripcion:
			"Adaptamos cada producto a tu identidad visual, colores y necesidades.",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`,
		color: "border-pink bg-pink/5 text-pink",
		iconColor: "text-pink",
	},
	{
		titulo: "Precios competitivos",
		descripcion:
			"Ofrecemos la mejor relación calidad-precio del mercado colombiano.",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
		color: "border-green bg-green/5 text-green",
		iconColor: "text-green",
	},
	{
		titulo: "Entrega rápida",
		descripcion: "Cumplimos los tiempos acordados y enviamos a todo Colombia.",
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0M1 3h13v11H1zm13 4h4l3 3v4h-7V7z"/></svg>`,
		color: "border-blue-light bg-blue-light/5 text-blue-light",
		iconColor: "text-blue-light",
	},
];

const stats = [
	{ valor: "+500", etiqueta: "Clientes satisfechos" },
	{ valor: "2+", etiqueta: "Años de experiencia" },
	{ valor: "100%", etiqueta: "Personalizable" },
	{ valor: "24h", etiqueta: "Tiempo de respuesta" },
];
---

<Layout
	title={`Sobre Nosotros | ${SITE.title}`}
	description="Conoce a J&A Cintas y Lanyards, empresa colombiana especializada en fabricación de lanyards y cintas personalizadas para eventos, empresas y promociones."
	canonicalURL={`${SITE.url}/sobre-nosotros`}
>
	<Header />

	<main id="main-content" role="main">
		<!-- Banner video en bucle -->
		<section
			class="relative h-72 md:h-96 flex items-center justify-center overflow-hidden"
		>
			<!-- Reemplaza /proceso-impresion.mp4 con la ruta real de tu video en /public -->
			<video
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster="/hero-nosotros-poster.webp"
				class="absolute inset-0 w-full h-full object-cover"
			>
				<source src={videoProceso} type="video/mp4" />
			</video>

			<!-- Overlay oscuro para que el texto sea legible -->
			<div class="absolute inset-0 bg-primary/65"></div>

			<!-- Texto sobre el video -->
			<div class="relative z-10 text-center px-4 max-w-2xl mx-auto">
				<ScrollReveal client:load>
					<span
						class="font-heading text-accent text-sm uppercase tracking-widest font-medium"
					>
						Quiénes somos
					</span>
					<h2
						class="font-heading text-3xl md:text-4xl font-bold text-white mt-2"
					>
						J&A Cintas y Lanyards
					</h2>
				</ScrollReveal>
			</div>
		</section>

		<!-- Historia + imagen -->
		<section class="max-w-6xl mx-auto px-4 py-20">
			<div class="flex flex-col md:flex-row items-center gap-16">

				<div class="flex-1 flex flex-col gap-6">
					<ScrollReveal client:load direction="left">
						<span
							class="font-heading text-accent text-sm uppercase tracking-widest font-medium"
						>
							Nuestra historia
						</span>
						<h2
							class="font-heading text-heading-xl font-semibold text-primary mt-2"
						>
							Fabricando con pasión desde el principio
						</h2>
					</ScrollReveal>
					<ScrollReveal client:load direction="left" delay={0.2}>
						<p class="font-body text-gray-dark/70 leading-relaxed">
							En J&A Cintas y Lanyards nos apasiona ayudar a las empresas a
							destacar su marca a través de productos promocionales
							personalizados. Nos especializamos en la fabricación de cintas,
							lanyards y accesorios de alta calidad para eventos, ferias y
							campañas publicitarias en todo Colombia.
						</p>
						<p class="font-body text-gray-dark/70 leading-relaxed mt-4">
							Nuestro compromiso es ofrecer soluciones creativas y efectivas,
							acompañando a cada cliente desde el diseño hasta la entrega final.
						</p>
					</ScrollReveal>
				</div>
			</div>
		</section>

		<!-- Stats -->
		<section class="bg-blue-light py-16 px-4">
			<div class="max-w-6xl mx-auto">
				<ul class="grid grid-cols-2 md:grid-cols-4 gap-8">
					{
						stats.map((stat, i) => (
							<ScrollReveal client:load delay={i * 0.15}>
								<li class="flex flex-col items-center text-center gap-2">
									<span class="font-display text-5xl text-white">
										{stat.valor}
									</span>
									<span class="font-body text-white/80 text-sm">
										{stat.etiqueta}
									</span>
								</li>
							</ScrollReveal>
						))
					}
				</ul>
			</div>
		</section>

		<!-- Valores -->
		<section class="max-w-6xl mx-auto px-4 py-20">
			<ScrollReveal client:load>
				<h2
					class="font-heading text-heading-xl font-semibold text-primary text-center mb-4"
				>
					Nuestros valores
				</h2>
				<p
					class="font-body text-center text-gray-dark/70 mb-16 max-w-xl mx-auto"
				>
					Estos principios guían cada producto que fabricamos y cada cliente que
					atendemos.
				</p>
			</ScrollReveal>

			<!-- Cards de valores -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{
					valores.map((v, i) => (
						<ScrollReveal client:load delay={i * 0.15}>
							<div
								class:list={[
									"flex flex-col items-center text-center gap-4 p-6 rounded-2xl border-2 transition-colors duration-200",
									v.color,
								]}
							>
								<span class={v.iconColor}>
									<Fragment set:html={v.icon} />
								</span>
								<h3 class="font-heading text-lg font-semibold text-primary">
									{v.titulo}
								</h3>
								<p class="font-body text-sm text-gray-dark/70">
									{v.descripcion}
								</p>
							</div>
						</ScrollReveal>
					))
				}
			</div>
		</section>

		<!-- CTA final -->
		<section class="bg-gray-light py-16 px-4">
			<div
				class="max-w-2xl mx-auto text-center flex flex-col items-center gap-6"
			>
				<ScrollReveal client:load>
					<h2 class="font-heading text-2xl font-semibold text-primary">
						¿Listo para trabajar juntos?
					</h2>
					<p class="font-body text-gray-dark/70 mt-2">
						Cuéntanos tu idea y te ayudamos a hacerla realidad.
					</p>
				</ScrollReveal>
				<ScrollReveal client:load delay={0.2}>
					<div class="flex flex-col sm:flex-row gap-4">
						<a
							href={`https://wa.me/${SITE.whatsAppAccount}?text=${encodeURIComponent(SITE.whatsAppMessage)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="bg-green hover:bg-green-hover
						text-white font-heading font-semibold px-8 py-4 rounded-lg transition-colors
						duration-200"
						>
							Escribir por WhatsApp
						</a>

						<a
							href="/contacto"
							class="bg-pink hover:bg-pink-hover
					text-white font-heading font-medium px-8 py-4 rounded-lg
					transition-colors duration-200"
						>
							Ir a contacto
						</a>
					</div>
				</ScrollReveal>
			</div>
		</section>
	</main>
</Layout>
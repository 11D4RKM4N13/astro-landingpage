---
// TeamSection.astro
import ScrollReveal from "./ScrollReveal.tsx";

interface TeamMember {
	name: string;
	role: string;
	avatar: string;
	color: string;
	accent: string;
}

const team: TeamMember[] = [
	{
		name: "Valentina Cruz",
		role: "Creative Director",
		avatar:
			"https://api.dicebear.com/9.x/notionists/svg?seed=valentina&backgroundColor=b6e3f4",
		color: "#F97316",
		accent: "#FB923C",
	},
	{
		name: "Mateo Ibáñez",
		role: "Lead Developer",
		avatar:
			"https://api.dicebear.com/9.x/notionists/svg?seed=mateo&backgroundColor=c0aede",
		color: "#8B5CF6",
		accent: "#A78BFA",
	},
	{
		name: "Sofía Romero",
		role: "UX Designer",
		avatar:
			"https://api.dicebear.com/9.x/notionists/svg?seed=sofia&backgroundColor=ffdfbf",
		color: "#EC4899",
		accent: "#F472B6",
	},
	{
		name: "Diego Paredes",
		role: "Product Manager",
		avatar:
			"https://api.dicebear.com/9.x/notionists/svg?seed=diego&backgroundColor=d1f4e0",
		color: "#10B981",
		accent: "#34D399",
	},
	{
		name: "Camila Torres",
		role: "Data Engineer",
		avatar:
			"https://api.dicebear.com/9.x/notionists/svg?seed=camila&backgroundColor=fad2e1",
		color: "#3B82F6",
		accent: "#60A5FA",
	},
	{
		name: "Andrés Lima",
		role: "Backend Developer",
		avatar:
			"https://api.dicebear.com/9.x/notionists/svg?seed=andres&backgroundColor=bee3f8",
		color: "#EF4444",
		accent: "#F87171",
	},
];
---

<!-- Matches the max-w-5xl mx-auto px-4 py-20 pattern of the about page -->
<section class="max-w-5xl mx-auto px-4 py-20">
	<ScrollReveal client:load delay={0.55}>
		<h2 class="text-3xl font-semibold mb-10 text-gray-900">Nuestro equipo</h2>
	</ScrollReveal>

	<div class="team-grid">
		{
			team.map((member, i) => (
				<ScrollReveal client:load delay={0.6 + i * 0.05}>
					<article
						class="member-card"
						style={`--card-color: ${member.color}; --card-accent: ${member.accent};`}
					>
						<div class="card-bar" />
						<div class="card-glow" />
						<div class="avatar-wrap">
							<img src={member.avatar} alt={member.name} class="avatar-img" />
							<div class="avatar-ring" />
						</div>
						<div>
							<p class="member-name">{member.name}</p>
							<p class="member-role">{member.role}</p>
						</div>
					</article>
				</ScrollReveal>
			))
		}
	</div>
</section>

<style>
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1rem;
	}

	/* Matches: p-6 border rounded-xl hover:shadow-lg transition */
	.member-card {
		position: relative;
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 0.75rem; /* rounded-xl */
		padding: 1.5rem;
		overflow: hidden;
		cursor: default;
		transition:
			transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
			box-shadow 0.35s cubic-bezier(0.23, 1, 0.32, 1),
			border-color 0.25s ease;
	}

	.member-card:hover {
		transform: translateY(-4px);
		box-shadow:
			0 10px 30px -6px color-mix(in srgb, var(--card-color) 20%, transparent),
			0 0 0 1px color-mix(in srgb, var(--card-color) 30%, transparent);
		border-color: color-mix(in srgb, var(--card-color) 35%, transparent);
	}

	/* Colored top bar — reveals on hover */
	.card-bar {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--card-color), var(--card-accent));
		border-radius: 0.75rem 0.75rem 0 0;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.member-card:hover .card-bar {
		transform: scaleX(1);
	}

	/* Soft glow blob */
	.card-glow {
		position: absolute;
		top: -40px;
		right: -40px;
		width: 130px;
		height: 130px;
		border-radius: 50%;
		background: radial-gradient(circle, var(--card-color) 0%, transparent 70%);
		opacity: 0.05;
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
		pointer-events: none;
	}

	.member-card:hover .card-glow {
		opacity: 0.13;
		transform: scale(1.3);
	}

	/* Avatar */
	.avatar-wrap {
		position: relative;
		width: 72px;
		height: 72px;
		margin-bottom: 1rem;
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		display: block;
		position: relative;
		z-index: 1;
		border: 2px solid #f3f4f6;
		transition: border-color 0.3s ease;
	}

	.member-card:hover .avatar-img {
		border-color: color-mix(in srgb, var(--card-color) 40%, white);
	}

	.avatar-ring {
		position: absolute;
		inset: -3px;
		border-radius: 50%;
		background: conic-gradient(
			from 0deg,
			var(--card-color),
			var(--card-accent),
			var(--card-color)
		);
		z-index: 0;
		opacity: 0;
		transition: opacity 0.3s ease;
		-webkit-mask: radial-gradient(
			farthest-side,
			transparent calc(100% - 2.5px),
			white calc(100% - 2.5px)
		);
		mask: radial-gradient(
			farthest-side,
			transparent calc(100% - 2.5px),
			white calc(100% - 2.5px)
		);
	}

	.member-card:hover .avatar-ring {
		opacity: 1;
		animation: spinRing 3s linear infinite;
	}

	@keyframes spinRing {
		to {
			transform: rotate(360deg);
		}
	}

	/* Text — matches page's text-gray-900 / text-gray-600 */
	.member-name {
		font-size: 1rem;
		font-weight: 600;
		color: #111827; /* text-gray-900 */
		line-height: 1.3;
		margin-bottom: 0.2rem;
		transition: color 0.25s ease;
	}

	.member-card:hover .member-name {
		color: var(--card-color);
	}

	.member-role {
		font-size: 0.8rem;
		font-weight: 400;
		color: #9ca3af; /* text-gray-400 */
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	@media (max-width: 640px) {
		.team-grid {
			grid-template-columns: 1fr 1fr;
			gap: 0.75rem;
		}
		.member-card {
			padding: 1.2rem;
		}
		.avatar-wrap {
			width: 58px;
			height: 58px;
		}
	}
</style>

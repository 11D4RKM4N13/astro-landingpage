---
const stats = [
	{
		icon: "users",
		value: "+500",
		label: "Clientes satisfechos",
	},
	{
		icon: "truck",
		value: "Envío",
		label: "A todo Colombia",
	},
	{
		icon: "clock",
		value: "Entrega",
		label: "En tiempo récord",
	},
	{
		icon: "star",
		value: "100%",
		label: "Personalizable",
	},
];

const icons: Record<string, string> = {
	users: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9-4.13a4 4 0 11-8 0 4 4 0 018 0zm6 4a4 4 0 00-3-3.87"/></svg>`,
	truck: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0M1 3h13v11H1zm13 4h4l3 3v4h-7V7z"/></svg>`,
	clock: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/></svg>`,
	star: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118L2.05 10.1c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
};
---

<section class="bg-primary py-10">
	<div class="max-w-6xl mx-auto px-4">
		<ul class="grid grid-cols-2 md:grid-cols-4 gap-6">
			{
				stats.map((stat) => (
					<li class="flex flex-col items-center text-center gap-2">
						<span class="text-accent" set:html={icons[stat.icon]} />
						<span class="font-heading text-2xl font-semibold text-white">
							{stat.value}
						</span>
						<span class="font-body text-sm text-white/80">{stat.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

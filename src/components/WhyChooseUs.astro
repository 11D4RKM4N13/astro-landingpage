---
const reasons = [
	{
		icon: "🎯",
		title: "Diseño estratégico",
		text: "No solo hacemos piezas bonitas, diseñamos con intención y objetivo.",
	},
	{
		icon: "🤝",
		title: "Acompañamiento cercano",
		text: "Trabajamos contigo durante todo el proceso, no solo entregamos archivos.",
	},
	{
		icon: "📈",
		title: "Enfoque en resultados",
		text: "Buscamos que tu comunicación tenga impacto real en tu público.",
	},
	{
		icon: "✨",
		title: "Soluciones a tu medida",
		text: "Cada proyecto se adapta a tu marca y a tus necesidades.",
	},
];
---

<section class="why-section">
	<h2 data-aos="fade-up">¿Por qué elegirnos?</h2>

	<div class="timeline">

		{
			reasons.map((reason, index) => (
				<div
					class="timeline-item"
					data-aos="fade-up"
					data-aos-delay={index * 120}
				>
					<div class="icon">{reason.icon}</div>

					<div class="content">
						<h3>{reason.title}</h3>
						<p>{reason.text}</p>
					</div>
				</div>
			))
		}

	</div>
</section>

<script>
	import AOS from "aos";
	import "aos/dist/aos.css";

	AOS.init({
		duration: 900,
		once: true
	});
</script>

<style>
.why-section{
	padding:4rem 1rem;
	background:#fafafa;
	text-align:center;
}

.timeline{
	margin-top:3rem;
	max-width:800px;
	margin-left:auto;
	margin-right:auto;
	position:relative;
}

.timeline::before{
	content:"";
	position:absolute;
	left:28px;
	top:0;
	bottom:0;
	width:2px;
	background:#ddd;
}

.timeline-item{
	display:flex;
	gap:1.2rem;
	margin-bottom:2rem;
	text-align:left;
	position:relative;
}

.icon{
	width:56px;
	height:56px;
	border-radius:50%;
	background:white;
	box-shadow:0 6px 14px rgba(0,0,0,0.08);
	display:flex;
	align-items:center;
	justify-content:center;
	font-size:1.5rem;
	position:relative;
	z-index:2;
}

.content{
	background:white;
	padding:1.3rem 1.5rem;
	border-radius:12px;
	box-shadow:0 6px 16px rgba(0,0,0,0.05);
	flex:1;
}

.content h3{
	margin-bottom:.3rem;
}

.content p{
	color:#666;
	font-size:.95rem;
}
</style>
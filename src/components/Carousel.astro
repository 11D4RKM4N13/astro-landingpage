---
interface Props {
	images: {
		src: string;
		alt: string;
	}[];
}

const { images = [] } = Astro.props;
---

<!-- Carousel Container -->
<div
	class="carousel-container relative overflow-hidden rounded-2xl bg-gray-100 group w-full shadow-2xl"
>
	<!-- Carousel Track -->
	<div
		class="carousel-track flex transition-transform duration-700 ease-in-out h-100 md:h-50"
	>
		{
			images.map((img) => (
				<div class="min-w-full h-full">
					<img
						src={img.src}
						alt={img.alt}
						class="w-full h-full object-cover select-none"
						loading="lazy"
					/>
				</div>
			))
		}
	</div>

	<!-- Previous Button -->
	<button
		id="prev"
		class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 p-3 rounded-full shadow-lg hover:bg-white opacity-0 group-hover:opacity-100 transition-all active:scale-95"
	>
		<iconify-icon icon="tabler:chevron-left" width="32" class="text-gray-800"
		></iconify-icon>
	</button>

	<!-- Next Button -->
	<button
		id="next"
		class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 p-3 rounded-full shadow-lg hover:bg-white opacity-0 group-hover:opacity-100 transition-all active:scale-95"
	>
		<iconify-icon icon="tabler:chevron-right" width="32" class="text-gray-800"
		></iconify-icon>
	</button>

	<!-- Dots -->
	<div
		class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3 bg-black/20 px-4 py-2 rounded-full backdrop-blur-sm"
	>
		{
			images.map((_, i) => (
				<button
					class="dot w-2.5 h-2.5 rounded-full transition-all duration-300"
					data-index={i}
					aria-label={`Go to slide ${i + 1}`}
				/>
			))
		}
	</div>
</div>

<script>
	// Usamos querySelectorAll dentro de un contexto para evitar conflictos si hay varios carruseles
	const containers = document.querySelectorAll(".carousel-container");

	containers.forEach((container) => {
		const track = container.querySelector(".carousel-track") as HTMLElement;
		const slides = container.querySelectorAll(".min-w-full");
		const prevBtn = container.querySelector("#prev");
		const nextBtn = container.querySelector("#next");
		const dots = container.querySelectorAll(".dot");

		let index = 0;

		function updateCarousel() {
			track.style.transform = `translateX(-${index * 100}%)`;
			dots.forEach((dot, i) => {
				if (i === index) {
					dot.classList.add("bg-white", "w-6"); // El punto activo se alarga
					dot.classList.remove("bg-white/50");
				} else {
					dot.classList.remove("bg-white", "w-6");
					dot.classList.add("bg-white/50");
				}
			});
		}

		nextBtn?.addEventListener("click", () => {
			index = (index + 1) % slides.length;
			updateCarousel();
		});

		prevBtn?.addEventListener("click", () => {
			index = (index - 1 + slides.length) % slides.length;
			updateCarousel();
		});

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				index = i;
				updateCarousel();
			});
		});

		// Autoplay opcional (descomenta si lo quieres)
		setInterval(() => {
			index = (index + 1) % slides.length;
			updateCarousel();
		}, 5000);

		updateCarousel();
	});
</script>

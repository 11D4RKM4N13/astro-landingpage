---
import ScrollReveal from "./ScrollReveal.tsx";

const whatsappMsg = encodeURIComponent(
	"Hola J&A Cintas y Lanyards, quiero hacer un pedido personalizado."
);
---

<section class="bg-accent py-24 px-4">
	<div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-8">
		<ScrollReveal client:load>
			<span
				class="font-heading text-white/70 text-sm uppercase tracking-widest font-medium"
			>
				¿Listo para personalizar?
			</span>
			<h2
				class="font-heading text-heading-xl md:text-4xl font-bold text-white mt-3 leading-tight"
			>
				Haz tu pedido hoy y recíbelo <br class="hidden md:block" />
				donde estés en Colombia
			</h2>
		</ScrollReveal>

		<ScrollReveal client:load delay={0.2}>
			<p class="font-body text-white/80 text-lg max-w-xl">
				Diseño a medida, materiales de calidad y entrega rápida. Escríbenos
				ahora y te respondemos en menos de 24 horas.
			</p>
		</ScrollReveal>

		<ScrollReveal client:load delay={0.3}>
			<div class="flex flex-col sm:flex-row items-center gap-4 mt-2">
				<!-- WhatsApp (principal) -->

				<a
					href={`https://wa.me/573208556455?text=${whatsappMsg}`}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-2 bg-green
				hover:bg-green-vibrant-hover text-white font-heading font-semibold px-8 py-4
				rounded-lg transition-colors duration-200"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						fill="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
						></path>
						<path
							d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.857L.057 23.882l6.174-1.453A11.942 11.942 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.371l-.36-.214-3.724.876.936-3.614-.235-.372A9.818 9.818 0 1112 21.818z"
						></path>
					</svg>
					Escribir por WhatsApp
				</a>

				<!-- Ver productos (secundario) -->

				<a
					href="/productos"
					class="font-heading font-medium text-white border
				border-white/50 hover:bg-white/10 px-6 py-4 rounded-lg transition-colors
				duration-200"
				>
					Ver productos
				</a>

				<!-- Contacto (terciario) -->

				<a
					href="/contacto"
					class="font-heading font-medium text-white/70
				hover:text-white underline underline-offset-4 transition-colors
				duration-200"
				>
					Ir a contacto
				</a>
			</div>
		</ScrollReveal>
	</div>
</section>

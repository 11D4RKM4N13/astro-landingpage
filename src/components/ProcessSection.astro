---
const steps = [
	{
		number: "01",
		title: "Entendemos tu proyecto",
		text: "Escuchamos tus ideas, objetivos y necesidades para comprender lo que realmente necesita tu marca.",
		image: "/project-understand.jpg",
	},
	{
		number: "02",
		title: "Propuesta creativa",
		text: "Definimos una solución visual estratégica que conecte con tu público.",
		image: "/creative.jpg",
	},
	{
		number: "03",
		title: "Diseño y desarrollo",
		text: "Creamos las piezas visuales, ajustamos detalles y refinamos el diseño.",
		image: "/design-development.jpg",
	},
	{
		number: "04",
		title: "Entrega final",
		text: "Te entregamos todos los recursos listos para usar en tus canales.",
		image: "/deploy.jpg",
	},
];
---

<section class="process-section">
	<h2>Nuestro proceso</h2>
	<p class="subtitle">
		Transformamos ideas en resultados con un proceso claro y colaborativo.
	</p>

	<div class="swiper processSwiper">
		<div class="swiper-wrapper">
			{
				steps.map((step) => (
					<div class="swiper-slide">
						<div class="process-card">
							<div class="image-container">
								<img src={step.image} alt={step.title} loading="lazy" />
								<span class="step-number">{step.number}</span>
							</div>

							<div class="content">
								<h3>{step.title}</h3>
								<p>{step.text}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="swiper-pagination"></div>
	</div>
</section>

<script>
	import Swiper from "swiper";
	import { Pagination, Autoplay } from "swiper/modules";

	import "swiper/css";
	import "swiper/css/pagination";

	new Swiper(".processSwiper", {
		modules: [Pagination, Autoplay],
		spaceBetween: 30,
		slidesPerView: 1,
		loop: true,

		autoplay: {
			delay: 4000,
		},

		pagination: {
			el: ".swiper-pagination",
			clickable: true,
		},

		breakpoints: {
			768: {
				slidesPerView: 2,
			},

			1024: {
				slidesPerView: 3,
			},
		},
	});
</script>

<style>
	.process-section {
		padding: 4rem 1rem;
		text-align: center;
	}

	.subtitle {
		color: #666;
		margin-bottom: 2.5rem;
	}

	.process-card {
		background: white;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.process-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08);
	}

	.image-container {
		position: relative;
		height: 200px;
		overflow: hidden;
	}

	.image-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.step-number {
		position: absolute;
		bottom: 10px;
		left: 10px;
		background: rgba(0, 0, 0, 0.7);
		color: white;
		font-size: 1.5rem;
		font-weight: bold;
		padding: 6px 10px;
		border-radius: 6px;
	}

	.content {
		padding: 1.5rem;
	}

	.content h3 {
		margin-bottom: 0.5rem;
	}

	.swiper {
		padding-bottom: 40px;
	}
</style>

---
const {
  image = "/divider.jpg",
  text = "",
  height = "40vh"
} = Astro.props;
---

<section
  class="divider"
  style={`background-image: url(${image}); height: ${height};`}
>
  {text && (
    <div class="overlay">
      <h2>{text}</h2>
    </div>
  )}
</section>

<style>
.divider {
  width: 100%;
  background-size: cover;
  background-position: center;
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;
}

.overlay {
    width: 100%;
  background: rgba(0, 0, 0, 0.164);
  padding: 2rem 3rem;
}

.overlay h2 {
  color: white;
  text-align: center;
  font-size: clamp(1.5rem, 3vw, 3rem);
}
</style>
---
import { Image } from "astro:assets";
import ScrollReveal from "./ScrollReveal.tsx";

import lanyardImage from "../assets/lanyard.png";
---

<section
	class="max-w-6xl mx-auto px-4 py-20 md:py-32"
	aria-labelledby="hero-heading"
>
	<div
		class="flex flex-col md:flex-row items-center gap-12 md:gap-20 lg:gap-20"
	>
		<!-- Columna izquierda: contenido -->
		<div class="flex-1 text-center md:text-left">
			<ScrollReveal client:load>
				<h1
					id="hero-heading"
					class="font-bold font-display text-primary text-heading-2xl"
				>
					J&A Cintas y Lanyards
				</h1>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.2}>
				<p class="text-xl md:text-2xl text-accent mb-8 max-w-2xl font-body">
					Especialistas en la fabricación de cintas y lanyards personalizados de
					alta calidad para eventos, empresas y promociones.
				</p>
			</ScrollReveal>
		</div>

		<!-- Columna derecha: imagen -->
		<div class="flex-1">
			<!-- Mobile: animación desde abajo -->
			<div class="block md:hidden">
				<ScrollReveal client:load delay={0.3}>
					<Image
						src={lanyardImage}
						alt="Cintas y lanyards personalizados"
						class="w-full h-auto rounded-xl"
						format="webp"
						quality={80}
						loading="eager"
						fetchpriority="high"
					/>
				</ScrollReveal>
			</div>

			<!-- Desktop: animación desde la derecha -->
			<div class="hidden md:block overflow-hidden">
				<ScrollReveal
					client:load
					duration={1.4}
					distance={60}
					delay={0.4}
					eager
				>
					<Image
						src={lanyardImage}
						alt="Cintas y lanyards personalizados"
						class="w-full h-auto rounded-xl"
						format="webp"
						quality={80}
						loading="eager"
						fetchpriority="high"
					/>
				</ScrollReveal>
			</div>
		</div>
	</div>
</section>

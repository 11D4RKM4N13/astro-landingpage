---
import ScrollReveal from "./ScrollReveal.tsx";
---

<section
	class="max-w-6xl mx-auto px-4 py-20 md:py-32"
	aria-labelledby="hero-heading"
>
	<div
		class="flex flex-col md:flex-row items-center gap-12 md:gap-20 lg:gap-20"
	>
		<!-- Columna izquierda: contenido -->
		<div class="flex-1 text-center md:text-left">
			<ScrollReveal client:load>
				<h1
					id="hero-heading"
					class="font-bold font-display text-primary text-heading-2xl"
				>
					J&A Cintas y Lanyards
				</h1>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.2}>
				<p class="text-xl md:text-2xl text-accent mb-8 max-w-2xl font-body">
					Especialistas en la fabricación de cintas y lanyards personalizados de
					alta calidad para eventos, empresas y promociones.
				</p>
			</ScrollReveal>
		</div>

		<!-- Columna derecha: imagen -->
		<div class="flex-1">
			<ScrollReveal
				client:load
				direction="left"
				duration={1.4}
				distance={500}
				delay={0.4}
			>
				<img
					src="/lanyard.png"
					alt="Cintas y lanyards personalizados"
					class="w-full h-auto rounded-xl object-cover"
				/>
			</ScrollReveal>
		</div>
	</div>
</section>

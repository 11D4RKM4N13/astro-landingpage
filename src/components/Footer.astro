---
import { Icon } from "astro-icon/components";
---

<footer
	id="contact"
	class="w-full py-12 px-4 border-t border-gray-200 bg-white"
	role="contentinfo"
>
	<div class="max-w-6xl mx-auto">
		<div class="grid md:grid-cols-3 gap-8 mb-8">
			<div>
				<h2 class="text-lg font-semibold text-primary mb-4 font-heading">
					J&A Cintas y Lanyards
				</h2>
				<p class="text-gray font-body">
					Especialistas en la fabricación de cintas y lanyards personalizados de
					alta calidad para eventos, empresas y promociones.
				</p>
			</div>
			<div>
				<h2 class="text-lg font-semibold text-primary mb-4 font-heading">
					Enlaces
				</h2>
				<ul class="space-y-2">
					<li>
						<a
							href="/productos"
							class="text-gray-dark hover:text-gray-dark-hover transition-colors font-body"
							>Productos y Servicios</a
						>
					</li>
					<li>
						<a
							href="/sobre-nosotros"
							class="text-gray-dark hover:text-gray-dark-hover transition-colors font-body"
							>Sobre Nosotros</a
						>
					</li>
					<li>
						<a
							href="/contact"
							class="text-gray-dark hover:text-gray-dark-hover transition-colors font-body"
							>Contacto</a
						>
					</li>
				</ul>
			</div>
			<div>
				<h2 class="text-lg font-semibold text-primary mb-4 font-heading">
					Conectar
				</h2>
				<ul class="space-y-2">
					<li>
						<a
							href="https://twitter.com"
							class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors font-body"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Follow us on Twitter (opens in new tab)"
						>
							<Icon
								name="tabler:brand-facebook"
								class="w-5 h-5"
								aria-hidden="true"
							/>
							<span>Facebook</span></a
						>
					</li>
					<li>
						<a
							href="https://twitter.com"
							class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors font-body"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Follow us on Twitter (opens in new tab)"
						>
							<Icon
								name="tabler:brand-instagram"
								class="w-5 h-5"
								aria-hidden="true"
							/>
							<span>Instagram</span></a
						>
					</li>
					<li>
						<a
							href="/contact"
							class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors font-body"
						>
							<Icon
								name="tabler:brand-gmail"
								class="w-5 h-5"
								aria-hidden="true"
							/>
							<span>Email</span></a
						>
					</li>
				</ul>
			</div>
		</div>
		<div
			class="pt-8 border-t border-gray-200 text-center text-primary font-display text-heading-sm"
		>
			<p>
				&copy; {new Date().getFullYear()} G&CO Creativos. All rights reserved.
			</p>
		</div>
	</div>
</footer>

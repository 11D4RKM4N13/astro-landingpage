---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-12 px-4 border-t border-gray-200 bg-white"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">G&CO Creativos</h2>
        <p class="text-gray-600">
          Una agencia de diseño y marketing digital especializada en soluciones creativas para empresas.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Enlaces</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/features"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Produtos y Servicios</a
            >
          </li>
          <li>
            <a
              href="/about"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Sobre Nosotros</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Contacto</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Conectar</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://twitter.com"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow us on Twitter (opens in new tab)"
            >
              <Icon name="tabler:brand-twitter" class="w-5 h-5" aria-hidden="true" />
              <span>Twitter</span></a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:mail" class="w-5 h-5" aria-hidden="true" />
              <span>Email</span></a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-gray-200 text-center text-gray-600">
      <p>&copy; {new Date().getFullYear()} G&CO Creativos. All rights reserved.</p>
    </div>
  </div>
</footer>

---
import ScrollReveal from "./ScrollReveal.tsx";

const pasos = [
  {
    numero: "01",
    titulo: "Contáctanos",
    descripcion:
      "Escríbenos por WhatsApp o llena el formulario con los detalles de tu pedido. Te respondemos en menos de 24 horas.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
  },
  {
    numero: "02",
    titulo: "Diseñamos juntos",
    descripcion:
      "Te enviamos una prueba digital con tu logo y colores. Ajustamos lo que necesites hasta que quedes 100% satisfecho.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`,
  },
  {
    numero: "03",
    titulo: "Producción y entrega",
    descripcion:
      "Fabricamos tu pedido con los más altos estándares de calidad y lo enviamos a cualquier parte de Colombia.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0M1 3h13v11H1zm13 4h4l3 3v4h-7V7z"/></svg>`,
  },
];
---

<section class="max-w-6xl mx-auto px-4 py-20">
  <ScrollReveal client:load>
    <h2 class="font-heading text-heading-xl font-semibold text-primary text-center mb-4">
      ¿Cómo funciona?
    </h2>
    <p class="font-body text-center text-gray-dark/70 mb-16 max-w-xl mx-auto">
      Pedir tus lanyards y cintas personalizadas es muy fácil. Solo sigue estos 3 pasos.
    </p>
  </ScrollReveal>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">

    <!-- Línea conectora (solo desktop) -->
    <div class="hidden md:block absolute top-10 left-1/4 right-1/4 h-px bg-accent/30 -z-0"></div>

    {pasos.map((paso, i) => (
      <ScrollReveal client:load direction="up" delay={i * 0.2}>
        <div class="flex flex-col items-center text-center gap-4 relative">

          <!-- Ícono con fondo -->
          <div class="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center text-primary z-10">
            <Fragment set:html={paso.icon} />
          </div>

          <!-- Número -->
          <span class="font-display text-5xl text-accent/20 leading-none -mt-2">
            {paso.numero}
          </span>

          <h3 class="font-heading text-xl font-semibold text-primary -mt-2">
            {paso.titulo}
          </h3>
          <p class="font-body text-sm text-gray-dark/70 max-w-xs">
            {paso.descripcion}
          </p>
        </div>
      </ScrollReveal>
    ))}
  </div>

  <!-- CTA final -->
  <ScrollReveal client:load delay={0.6}>
<div class="text-center mt-16">
  <a
    href="https://wa.me/573208556455?text=Hola%20Lanyards%20Colombia%2C%20quiero%20hacer%20un%20pedido"
    target="_blank"
    rel="noopener noreferrer"
    class="bg-green hover:bg-green-hover text-white font-medium px-8 py-4 rounded-lg transition-colors duration-200 inline-block font-body"
  >
    Empezar ahora
  </a>
</div>
  </ScrollReveal>
</section>
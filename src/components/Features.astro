---
// PortfolioSection.astro
import ScrollReveal from "./ScrollReveal.tsx";

const projects = [
  {
    title: "Packaging",
    category: "Branding",
    description: "Diseño de empaques creativos para marca de alimentos.",
    image: "/packaging.jpg",
    color: "#F97316",
  },
  {
    title: "Identidad Visual",
    category: "Branding",
    description: "Sistema visual completo para empresa tecnológica.",
    image: "/visual-identity.jpg",
    color: "#8B5CF6",
  },
  {
    title: "Merchandising",
    category: "Campaña",
    description: "Material gráfico para campaña política.",
    image: "/merchandesing.jpg",
    color: "#EC4899",
  },
];

// Unique categories for filter tabs
const categories = ["Todos", ...new Set(projects.map((p) => p.category))];
---

<section class="max-w-5xl mx-auto px-4 py-20">
  <!-- Header -->
  <ScrollReveal client:load delay={0.1}>
    <div class="section-header">
      <h2 class="text-3xl font-semibold text-gray-900 mb-2">Proyectos destacados</h2>
      <p class="text-gray-600">Algunos de los trabajos que hemos desarrollado.</p>
    </div>
  </ScrollReveal>

  <!-- Filter tabs -->
  <ScrollReveal client:load delay={0.15}>
    <div class="filter-tabs" role="tablist" aria-label="Filtrar proyectos">
      {
        categories.map((cat) => (
          <button
            class="filter-btn"
            data-filter={cat}
            role="tab"
            aria-selected={cat === "Todos" ? "true" : "false"}
          >
            {cat}
          </button>
        ))
      }
    </div>
  </ScrollReveal>

  <!-- Grid -->
  <div class="portfolio-grid" id="portfolio-grid">
    {
      projects.map((project, i) => (
        <ScrollReveal client:load delay={0.2 + i * 0.08}>
          <article
            class="portfolio-item"
            data-category={project.category}
            style={`--accent: ${project.color}`}
          >
            <!-- Image -->
            <div class="img-wrap">
              <img src={project.image} alt={project.title} class="project-img" />
              <div class="img-overlay" />
            </div>

            <!-- Bottom info (always visible) -->
            <div class="card-footer">
              <span class="category-tag">{project.category}</span>
              <h3 class="project-title">{project.title}</h3>
            </div>

            <!-- Hover panel -->
            <div class="hover-panel">
              <span class="hover-category">{project.category}</span>
              <h3 class="hover-title">{project.title}</h3>
              <p class="hover-desc">{project.description}</p>
              <span class="view-btn">
                Ver proyecto
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </article>
        </ScrollReveal>
      ))
    }
  </div>

  <!-- Empty state -->
  <div class="empty-state" id="empty-state" hidden>
    <p>No hay proyectos en esta categoría.</p>
  </div>
</section>

<script>
  // Filter logic
  const btns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".portfolio-item");
  const emptyState = document.getElementById("empty-state")!;

  function applyFilter(filter: string) {
    let visible = 0;

    btns.forEach((b) => {
      const isActive = b.dataset.filter === filter;
      b.setAttribute("aria-selected", isActive ? "true" : "false");
      b.classList.toggle("active", isActive);
    });

    items.forEach((item) => {
      // Hide the ScrollReveal wrapper (parent) so the reveal container collapses too
      const parent = item.parentElement;
      const target = (parent && parent !== document.querySelector(".portfolio-grid"))
        ? parent as HTMLElement
        : item;
      const match = filter === "Todos" || item.dataset.category === filter;

      if (match) {
        target.style.display = "";
        visible++;
      } else {
        target.style.display = "none";
      }
    });

    emptyState.hidden = visible > 0;
  }

  btns.forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.filter ?? "Todos"));
  });

  // Set initial active
  document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="Todos"]')?.classList.add("active");
</script>

<style>
  /* ── Header ── */
  .section-header {
    margin-bottom: 2rem;
  }

  /* ── Filter tabs ── */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    background: #fff;
    color: #6b7280;
    font-size: 0.85rem;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: #9ca3af;
    color: #111827;
  }

  .filter-btn.active,
  .filter-btn[aria-selected="true"] {
    background: #111827;
    border-color: #111827;
    color: #fff;
  }

  /* ── Grid ── */
  .portfolio-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .portfolio-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1024px) {
    .portfolio-grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  /* ── Card ── */
  .portfolio-item {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 0.35s cubic-bezier(0.23, 1, 0.32, 1),
                border-color 0.25s ease;
  }

  .portfolio-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px -8px color-mix(in srgb, var(--accent) 25%, transparent),
                0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* ── Image ── */
  .img-wrap {
    position: relative;
    overflow: hidden;
    height: 220px;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .portfolio-item:hover .project-img {
    transform: scale(1.07);
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.35) 100%);
    transition: opacity 0.3s ease;
  }

  .portfolio-item:hover .img-overlay {
    opacity: 0;
  }

  /* ── Footer (always visible) ── */
  .card-footer {
    padding: 1rem 1.2rem 1.1rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .portfolio-item:hover .card-footer {
    opacity: 0;
    transform: translateY(4px);
  }

  .category-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    line-height: 1.3;
  }

  /* ── Hover panel ── */
  .hover-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.4rem;
    background: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    border-top: 3px solid var(--accent);
  }

  .portfolio-item:hover .hover-panel {
    opacity: 1;
    transform: translateY(0);
  }

  .hover-category {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .hover-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .hover-desc {
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.55;
    flex: 1;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    transition: gap 0.2s ease;
  }

  .portfolio-item:hover .view-btn {
    gap: 0.6rem;
  }

  /* ── Empty state ── */
  .empty-state {
    text-align: center;
    padding: 3rem 0;
    color: #9ca3af;
    font-size: 0.95rem;
  }
</style>
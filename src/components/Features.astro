---
const projects = [
  {
    title: "Packaging",
    category: "Branding",
    description: "Diseño de empaques creativos para marca de alimentos.",
    image: "/portfolio/packaging.jpg",
  },
  {
    title: "Identidad Visual",
    category: "Branding",
    description: "Sistema visual completo para empresa tecnológica.",
    image: "/portfolio/branding.jpg",
  },
  {
    title: "Merchandising",
    category: "Campaña",
    description: "Material gráfico para campaña política.",
    image: "/portfolio/merchandising.jpg",
  },
];
---

<section class="portfolio">

<header class="portfolio-header">
<h2>Proyectos destacados</h2>
<p>Algunos de los trabajos que hemos desarrollado.</p>
</header>

<div class="portfolio-grid">

{
projects.map(project => (

<article class="portfolio-item reveal">

<img src={project.image} alt={project.title} />

<div class="portfolio-info">

<span class="category">{project.category}</span>

<h3>{project.title}</h3>

<p>{project.description}</p>

</div>

</article>

))
}

</div>

</section>

<script>
const observer = new IntersectionObserver((entries)=>{
entries.forEach(entry=>{
if(entry.isIntersecting){
entry.target.classList.add("visible")
}
})
})

document.querySelectorAll(".reveal").forEach(el=>{
observer.observe(el)
})
</script>

<style>

.portfolio{
padding:6rem 1rem;
max-width:1200px;
margin:auto;
}

.portfolio-header{
text-align:center;
margin-bottom:4rem;
}

.portfolio-header p{
color:#666;
}

.portfolio-grid{
display:grid;
grid-template-columns:1fr;
gap:60px;
}

.portfolio-item{
position:relative;
overflow:hidden;
border-radius:18px;
cursor:pointer;
transform:translateY(60px);
opacity:0;
transition:all .8s ease;
}

.portfolio-item.visible{
transform:translateY(0);
opacity:1;
}

.portfolio-item img{
width:100%;
height:420px;
object-fit:cover;
transition:transform .7s ease;
}

.portfolio-item:hover img{
transform:scale(1.08);
}

.portfolio-info{
position:absolute;
bottom:0;
left:0;
right:0;
padding:2rem;
color:white;
background:linear-gradient(transparent,rgba(0,0,0,.8));
}

.category{
font-size:.8rem;
opacity:.8;
letter-spacing:1px;
}

.portfolio-info h3{
margin:.4rem 0;
}

.portfolio-info p{
font-size:.9rem;
opacity:.9;
}

@media(min-width:768px){

.portfolio-grid{
grid-template-columns:1fr 1fr;
}

}

@media(min-width:1024px){

.portfolio-grid{
grid-template-columns:1fr 1fr 1fr;
}

}

</style>
---
import ScrollReveal from "./ScrollReveal.tsx";

const diferenciales = [
	{
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
		texto: "Calidad del material",
	},
	{
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
		texto: "Precios competitivos",
	},
	{
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg>`,
		texto: "Diseño a medida",
	},
	{
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/></svg>`,
		texto: "Entrega rápida",
	},
];
---

<section class="max-w-6xl mx-auto px-4 py-20">
	<div class="flex flex-col md:flex-row items-center gap-16">
		<!-- Imagen -->
		<ScrollReveal client:load direction="right" duration={1.4} distance={80}>
			<div class="flex-1 w-full">
				<div
					class="bg-primary/10 rounded-2xl overflow-hidden aspect-square flex items-center justify-center"
				>
					<img
						src="/nosotros-placeholder.webp"
						alt="Equipo J&A Cintas y Lanyards"
						class="w-full h-full object-cover"
						onerror="this.style.display='none'"
					/>
					<span
						class="font-heading text-primary/30 text-lg font-medium absolute"
					>
						Foto del equipo
					</span>
				</div>
			</div>
		</ScrollReveal>

		<!-- Contenido -->
		<div class="flex-1 flex flex-col gap-6">
			<ScrollReveal client:load direction="left" duration={1.2}>
				<span
					class="font-heading text-accent font-medium text-sm uppercase tracking-widest"
				>
					Quiénes somos
				</span>
				<h2
					class="font-heading text-heading-xl font-semibold text-primary mt-2"
				>
					Más de 2 años fabricando con pasión
				</h2>
			</ScrollReveal>

			<ScrollReveal client:load direction="left" delay={0.2}>
				<p class="font-body text-gray-dark/70 text-base leading-relaxed">
					En J&A Cintas y Lanyards nos especializamos en la fabricación de
					lanyards y cintas personalizadas para empresas, eventos y promociones.
					Trabajamos con materiales de alta calidad y ofrecemos atención
					personalizada en cada pedido.
				</p>
			</ScrollReveal>

			<!-- Diferenciales -->
			<ScrollReveal client:load direction="left" delay={0.3}>
				<ul class="grid grid-cols-2 gap-3 mt-2">
					{
						diferenciales.map((d) => (
							<li class="flex items-center gap-2 text-gray-dark">
								<span class="text-green-vibrant shrink-0">
									<Fragment set:html={d.icon} />
								</span>
								<span class="font-body text-sm">{d.texto}</span>
							</li>
						))
					}
				</ul>
			</ScrollReveal>

			<!-- CTA -->
			<ScrollReveal client:load direction="left" delay={0.4}>
				<a
					href="/sobre-nosotros"
					class="inline-block border border-primary text-primary hover:bg-primary hover:text-white font-heading font-medium px-6 py-3 rounded-lg transition-colors duration-200 mt-2"
				>
					Conócenos más
				</a>
			</ScrollReveal>
		</div>
	</div>
</section>

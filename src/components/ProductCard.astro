---
import { Image } from "astro:assets";

interface Props {
	nombre: string;
	descripcion: string;
	precio?: number;
	categoria: string;
	imagen: string;
	slug: string;
}

const { nombre, descripcion, precio, categoria, imagen, slug } = Astro.props;

const whatsappMsg = encodeURIComponent(
	`Hola, me interesa el producto: ${nombre}. ¿Me pueden dar más información?`
);
---

<article
	class="bg-white rounded-2xl overflow-hidden border border-gray-100 flex flex-col"
>
	<div class="overflow-hidden aspect-3/2">
		<Image
			src={imagen}
			alt={nombre}
			width={600}
			height={400}
			format="webp"
			quality={75}
			loading="lazy"
			decoding="async"
			class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
		/>
	</div>

	<div class="p-5 flex flex-col flex-1 gap-3">
		<span
			class="text-xs font-heading font-medium uppercase tracking-wide text-accent"
		>
			{categoria}
		</span>
		<h3 class="font-heading text-lg font-semibold text-primary">
			{nombre}
		</h3>
		<p class="font-body text-sm text-gray-dark/80 flex-1">
			{descripcion}
		</p>

		<div class="flex items-center justify-between mt-2">
			{
				precio ? (
					<span class="font-heading text-xl font-bold text-primary">
						${precio.toLocaleString("es-CO")}
					</span>
				) : (
					<span class="font-heading text-sm font-medium text-gray-dark/50 italic">
						Precio a cotizar
					</span>
				)
			}

			<a
				href={`https://wa.me/573208556455?text=${whatsappMsg}`}
				target="_blank"
				rel="noopener noreferrer"
				class="bg-accent hover:bg-accent-hover
			text-white text-sm font-heading font-medium px-4 py-2 rounded-lg transition-colors
			duration-200"
			>
				Cotizar
			</a>
		</div>
	</div>
</article>

---
import "../styles/global.css";
import { SITE } from "../config/site.mjs";
import type { SEOProps } from "../types/seo";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

interface Props extends SEOProps {
	lang?: string;
}

const {
	title = SITE.title,
	description = SITE.description,
	canonicalURL,
	ogTitle = title,
	ogDescription = description,
	ogImage = SITE.ogImage,
	ogType = "website",
	twitterCard = "summary_large_image",
	twitterTitle = ogTitle,
	twitterDescription = ogDescription,
	twitterImage = ogImage,
	noindex = false,
	nofollow = false,
	lang = SITE.defaultLanguage,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalPath = canonicalURL || currentPath;
const siteURL = new URL(canonicalPath, SITE.url);

const getFullImageUrl = (image: string): string => {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		return image;
	}
	return new URL(image, SITE.url).href;
};

const fullOgImage = getFullImageUrl(ogImage);
const fullTwitterImage = getFullImageUrl(twitterImage);

const robotsContent = [
	noindex ? "noindex" : "index",
	nofollow ? "nofollow" : "follow",
].join(", ");

// JSON-LD para negocio local
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	name: "J&A Cintas y Lanyards",
	description: SITE.description,
	url: SITE.url,
	telephone: "+573208556455",
	address: {
		"@type": "PostalAddress",
		addressCountry: "CO",
	},
	sameAs: [
		"https://www.instagram.com/jyacintasylanyards",
		"https://www.facebook.com/jyacintasylanyards",
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat+Alternates:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Oswald:wght@200..700&display=swap"
			rel="stylesheet"
		/>

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<meta name="author" content={SITE.author} />
		<link rel="canonical" href={siteURL.href} />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={siteURL.href} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={fullOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:locale" content={SITE.locale} />

		<!-- Twitter -->
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={siteURL.href} />
		<meta name="twitter:title" content={twitterTitle} />
		<meta name="twitter:description" content={twitterDescription} />
		<meta name="twitter:image" content={fullTwitterImage} />

		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<GoogleAnalytics />
	</head>
	<body class="min-h-screen bg-gray-50">
		<slot />
	</body>
</html>
